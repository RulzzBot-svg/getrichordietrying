# -------------------------------------------------------
# Field Service Platform — Backend Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit your actual .env file to source control.
# -------------------------------------------------------

# -----------------------
# Database
# -----------------------
# PostgreSQL connection string (required)
DATABASE_URL=postgresql://user:password@localhost:5432/fieldservice

# -----------------------
# CORS
# -----------------------
# Comma-separated list of allowed frontend origins.
# Add every domain where your React app is hosted.
# Example: https://app.yourdomain.com,https://staging.yourdomain.com
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174

# -----------------------
# Flask
# -----------------------
# Set to "production" for live deployments
FLASK_ENV=development
# Secret key used for session signing — set a long random string in production
SECRET_KEY=change-me-to-a-random-secret
